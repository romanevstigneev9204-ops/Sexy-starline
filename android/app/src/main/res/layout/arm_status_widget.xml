<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_night_drive_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_brand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="0.08"
        android:text="@string/widget_brand"
        android:textAllCaps="true"
        android:textColor="@color/night_drive_cyan"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="SEXY STARLINE" />

    <TextView
        android:id="@+id/widget_device_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/night_drive_text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="Camry" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_status_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_status_dot"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/night_drive_cyan"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Под охраной" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/night_drive_text_secondary"
        android:textSize="12sp"
        tools:text="2 мин назад" />

    <TextView
        android:id="@+id/widget_action_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/widget_cta_bg"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:text="@string/widget_open"
        android:textColor="@color/night_drive_graphite"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="Снять" />

    <LinearLayout
        android:id="@+id/widget_secondary_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/widget_arm_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_secondary_bg"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="@string/widget_arm"
            android:textColor="@color/night_drive_cyan"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_disarm_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_secondary_bg"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="@string/widget_disarm"
            android:textColor="@color/night_drive_amber"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
