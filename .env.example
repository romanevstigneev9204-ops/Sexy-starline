# Template only — Flutter does NOT auto-load this file.
# Pass values via --dart-define (or CI secrets), e.g.:
#   flutter run \
#     --dart-define=STARLINE_APP_ID=... \
#     --dart-define=STARLINE_APP_SECRET=...
# NEVER commit real AppId or Secret. Keep a private .env locally if you want
# (gitignored); still wire into dart-define yourself.

STARLINE_APP_ID=
STARLINE_APP_SECRET=

# Optional overrides
# STARLINE_DEMO=true
# STARLINE_SLID_BASE=https://id.starline.ru
# STARLINE_API_BASE=https://developer.starline.ru

# Map tiles (optional). Default: free OSM + Night Drive color filter (no key).
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png?apikey={api_key}
# MAP_TILE_KEY=
# MAP_TILE_NIGHT_FILTER=false
